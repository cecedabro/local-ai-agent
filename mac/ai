#!/usr/bin/env bash
# Pause / resume / check the local model on the Windows PC, from the Mac.
#   ai pause    stop llama-server and free VRAM/RAM (nothing can restart it until resume)
#   ai resume   allow and start llama-server again (model takes about a minute to load)
#   ai status   paused / active, and whether a job holds the PC awake
#   ai gpu on|off|status   the cv-skills GPU gatekeeper (pc/gpu-gate): swap the stack in, back, or show its state.
#                Uses CV_GATE_URL (default http://cv-skills-gpu, over Tailscale).
# Runs the same steps as pc/power/ai.ps1, through `ssh pc` into WSL.
set -euo pipefail

if [[ "${1:-}" == gpu ]]; then
  url="${CV_GATE_URL:-http://cv-skills-gpu}"
  case "${2:-status}" in
    on)     method=POST path=/v1/warmup ;;
    off)    method=POST path=/v1/cooldown ;;
    status) method=GET path=/v1/status ;;
    *) echo "usage: ai gpu on|off|status" >&2; exit 2 ;;
  esac
  # Access is the tailnet policy (this Mac is a member). Plain HTTP: Tailscale already encrypts the hop.
  curl -sS --max-time 15 -X "${method}" -H "X-Requester: ${USER:-mac}" "${url}${path}" \
    || { echo "gatekeeper unreachable (PC asleep or off?)" >&2; exit 1; }
  echo
  exit 0
fi

case "${1:-}" in
  # Dropping the page cache matters: the model file stays cached in WSL's VM after the
  # server stops, and WSL on Windows 10 does not give that memory back by itself.
  pause)  script='mkdir -p /run/ai && touch /run/ai/paused && systemctl stop llama-server && sync && echo 3 > /proc/sys/vm/drop_caches && echo 1 > /proc/sys/vm/compact_memory && echo "paused: VRAM and RAM freed"' ;;
  resume) script='rm -f /run/ai/paused && systemctl start llama-server && echo "resumed: model loading"' ;;
  status) script='if test -e /run/ai/paused; then echo paused; else systemctl is-active llama-server || true; fi; if test -e /run/ai/busy; then echo busy; fi' ;;
  *) echo "usage: ai pause|resume|status|gpu on|gpu off|gpu status" >&2; exit 2 ;;
esac

# The script goes in on stdin (quoting through PowerShell breaks otherwise).
ssh pc 'wsl -d Ubuntu -u root -- bash -s' <<<"$script"
