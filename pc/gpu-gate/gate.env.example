# /etc/cv-gate/gate.env (root 0640, group cv-gate). Read by cv-gpu-gate.service.
GATE_PORT=8088
GATE_UPSTREAM=http://127.0.0.1:8089
GATE_IDLE_S=600
GATE_LOAD_TIMEOUT_S=300
# Optional: the agent-status service, so agent runs see the GPU is taken (model lease).
# STATUS_URL=REPLACE_ME
# STATUS_TOKEN=REPLACE_ME
