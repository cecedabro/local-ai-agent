# /etc/llama/llama-server.env — flags for llama-server.service.
# Tune N_CPU_MOE with bench.sh, then confirm on the server (it needs ~0.7 GB more than the bench:
# 48k context + MTP draft). RTX 3080 Ti 12 GB: 26 = ~36 tok/s, 11.3 GB; 24 spills and drops to ~4 tok/s.
MODEL=/home/REPLACE_ME/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
ALIAS=coder
CTX=49152
N_CPU_MOE=26
PORT=8080
API_KEY_FILE=/etc/llama/api-key
# Sampling: publisher defaults for Qwen3.6. MTP draft flags from Unsloth's card.
# -ub 2048: prompt reading ~280 -> ~790 tok/s with CPU experts (bigger chunks per copy to the GPU);
# the draft context stays at 512 so VRAM is unchanged. Generation speed is the same.
EXTRA_ARGS=--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --spec-type draft-mtp --spec-draft-n-max 2 -ub 2048 --spec-draft-n-ubatch 512
