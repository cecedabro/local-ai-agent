# /etc/llama/llama-server.env — flags for llama-server.service.
# Tune N_CPU_MOE with bench.sh. Swap MODEL here when upgrading; keep ALIAS=coder.
MODEL=/home/REPLACE_ME/models/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf
ALIAS=coder
CTX=49152
N_CPU_MOE=20
PORT=8080
API_KEY_FILE=/etc/llama/api-key
# Sampling: publisher defaults for Qwen3.6. MTP draft flags from Unsloth's card.
EXTRA_ARGS=--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0 --spec-type draft-mtp --spec-draft-n-max 2
