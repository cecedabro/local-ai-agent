# Copy to %UserProfile%\.wslconfig, then run `wsl --shutdown` in PowerShell.
[wsl2]
# 32 GB host: leave ~6 GB for Windows. Model weights mmap'd from disk count here.
memory=26GB
swap=8GB
# WSL services reachable on the PC's own LAN IP; no portproxy rules.
networkingMode=mirrored
# Keep the VM alive when no terminal is open (needed for llama-server).
vmIdleTimeout=-1
